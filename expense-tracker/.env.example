# ─────────────────────────────────────────────────────────────────────────────
# Expense tracker — environment variables
# Copy to `.env` for local development:  cp .env.example .env
# Never commit real values. Generate secrets with:  openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Postgres connection string. The default matches docker-compose.yml.
DATABASE_URL=postgres://expense:expense@localhost:5432/expense
# TLS for Postgres: leave empty for local / Railway private network,
# `require` to use TLS and verify the certificate, `no-verify` to use TLS with
# any certificate (some hosted Postgres providers need this).
DATABASE_SSL=

# ── Auth (required) ──────────────────────────────────────────────────────────
# The single password that unlocks the web app.
APP_PASSWORD=change-me
# Secret used to sign the session cookie. At least 32 random characters.
# Changing it logs out every device.
SESSION_SECRET=replace-with-openssl-rand-base64-32-output
# Bearer token the iOS Shortcut (and cron caller) sends to the ingest API:
#   Authorization: Bearer <INGEST_TOKEN>
# At least 24 random characters. Rotate it if your phone is lost.
INGEST_TOKEN=replace-with-another-long-random-string

# ── App ──────────────────────────────────────────────────────────────────────
# Time zone used for "today", day grouping and budgets (IANA name).
APP_TIMEZONE=Asia/Kolkata
# Public URL of the deployed app (no trailing slash). Only used to show the
# webhook URL on the Settings page. Example: https://expense.up.railway.app
PUBLIC_BASE_URL=

# ── Email poller (optional) ──────────────────────────────────────────────────
# Leave IMAP_HOST / IMAP_USER / IMAP_PASSWORD empty to disable email ingestion;
# the web app works fine without it.
# Gmail: IMAP_HOST=imap.gmail.com, IMAP_USER=you@gmail.com,
#        IMAP_PASSWORD=<16-char app password from myaccount.google.com/apppasswords>
IMAP_HOST=
IMAP_PORT=993
# true = implicit TLS (port 993). Only set false for STARTTLS/plain servers.
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
# Folder to read. For Gmail you can also use a label, e.g. "Bank alerts".
IMAP_MAILBOX=INBOX
# How often the worker checks the mailbox, in seconds.
IMAP_POLL_INTERVAL_SECONDS=120
# Look at mail received in the last N days (already-ingested Message-IDs are skipped).
IMAP_LOOKBACK_DAYS=3
# true = only look at unread mail. Default false, so an alert you already opened on
# your phone before the next poll is still picked up.
IMAP_ONLY_UNSEEN=false
# Emails whose subject contains this tag are processed even if the sender is not
# a known bank (used by the "forward SMS by email" Shortcut fallback).
IMAP_SUBJECT_TAG=[ET-SMS]
# Extra sender addresses or domains to treat as bank alerts, comma-separated.
# Example: alerts@mybank.com,@smallfinancebank.in
IMAP_EXTRA_SENDERS=
# Mark processed emails as read (\Seen). Message-IDs are stored either way, so
# nothing is ingested twice even if this is false.
IMAP_MARK_SEEN=true

# ── Tests (optional) ─────────────────────────────────────────────────────────
# Database for the Postgres integration tests (`npm test`). They are skipped if
# it is unreachable. docker-compose creates it automatically on first start;
# otherwise: createdb -h localhost -U expense expense_test
TEST_DATABASE_URL=postgres://expense:expense@localhost:5432/expense_test
