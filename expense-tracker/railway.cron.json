{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "echo 'cron: no build step needed (runs TypeScript via tsx)'",
    "watchPatterns": ["/expense-tracker/src/**", "/expense-tracker/package*.json"]
  },
  "deploy": {
    "startCommand": "npm run poll:once",
    "cronSchedule": "*/5 * * * *",
    "restartPolicyType": "NEVER"
  }
}
