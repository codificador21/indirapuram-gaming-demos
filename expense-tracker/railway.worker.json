{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "echo 'worker: no build step needed (runs TypeScript via tsx)'",
    "watchPatterns": ["/expense-tracker/src/**", "/expense-tracker/package*.json"]
  },
  "deploy": {
    "startCommand": "npm run worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
